# ==============================================================================
# GROSS MANAGEMENT — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Rename or copy this file to `.env` and fill in your Supabase credentials.
# The system automatically loads this file on startup with zero extra dependencies.
# ==============================================================================

# --- 1. SUPABASE POSTGRESQL DATABASE (PRIMARY) ---
# Find in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Direct connection:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler connection (recommended for production):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- 2. SUPABASE REST & REALTIME API ---
# Project Settings -> API -> Project URL:
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Project Settings -> API -> anon public key:
SUPABASE_ANON_KEY=eyJhbGciOi...
# Project Settings -> API -> service_role secret:
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- 3. SERVER & LOCAL FALLBACK (When DATABASE_URL is not set) ---
PORT=8000
DB_FILE=./backend_py/data/gross.db
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- 3. COURIER INTEGRATION (STEADFAST / PATHAO) ---
# Default provider: steadfast (or pathao)
COURIER_PROVIDER=steadfast
# Steadfast Merchant Portal -> API Settings:
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
# Pathao credentials (if using Pathao):
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=

# --- 4. META ADS (FACEBOOK / INSTAGRAM ADS LIVE SPEND) ---
# Meta Business Manager -> System Users -> Generate Token (with ads_read permission)
META_ACCESS_TOKEN=your_meta_system_user_access_token
# Ad Account ID from Ads Manager (with or without `act_` prefix)
META_AD_ACCOUNT_ID=act_1234567890
META_PIXEL_ID=123456789012345

# --- 5. WHATSAPP CLOUD API (META DEVELOPERS) ---
# Meta for Developers -> WhatsApp -> API Setup:
WHATSAPP_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=105938472910
WHATSAPP_BUSINESS_ACCOUNT_ID=waba_1029384
# Secret token you choose in Meta Webhook configuration:
WHATSAPP_VERIFY_TOKEN=gross_verify_token
# Meta App Dashboard -> App Settings -> Basic -> App Secret (for webhook signature verification):
WHATSAPP_APP_SECRET=

# --- 6. E-COMMERCE STORE WEBHOOKS (SHOPIFY / WOOCOMMERCE / CUSTOM) ---
# Secret for incoming POST /webhooks/orders requests
STORE_WEBHOOK_SECRET=your_store_webhook_secret_token

# --- 7. OPTIONAL AI (ANTHROPIC CLAUDE FOR WHATSAPP EXPENSE PARSING) ---
# If omitted, Gross Management uses its built-in Bangla natural language regex engine.
ANTHROPIC_API_KEY=
